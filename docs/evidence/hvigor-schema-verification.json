            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ignoreCrossPlatform": {
            "description": "Whether to suppress errors for unsupported cross-platform APIs.",
            "type": "boolean"
          }
        }
      }
    },
    "required": [
      "crossplatform",
      "modules"
    ]
  },
  "type_declaration": "export declare namespace ArkUIXConfigJson {\n    interface ConfigObj {\n        crossplatform: boolean;\n        modules: string[];\n        buildOption?: {\n            resConfigs?: string[];\n            ignoreCrossPlatform?: boolean;\n        };\n    }\n}\n",
