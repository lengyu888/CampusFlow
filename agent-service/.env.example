APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_PATH=data/campusflow.db
# 生产环境必填。生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_ENABLED=true
# 第十六阶段：保留上述 DeepSeek 个人 Key，额外供应商默认关闭。
MODEL_DEFAULT_ID=deepseek-v4-pro
MODEL_CATALOG_JSON=[]
# 配置格式与安全边界见 ../docs/project-documents/model-providers.md。
# 每个额外模型的 key_env 只读取服务进程环境；不要在目录 JSON 中填写真实密钥。
# 动态 key_env 不会从本 .env 自动加载，应由进程启动环境或部署 secret 注入。
AGENT_TIMEOUT_SECONDS=180
AGENT_FINAL_RESPONSE_RESERVE_SECONDS=45
# 明确日期范围的新建学习计划使用分阶段流程；设为 false 并重启后端可恢复原流程。
AGENT_STAGED_PLANNING_ENABLED=true
# 每轮对话按资源获取最新校园资料；false 恢复只读本地快照（无需改令牌）。
AGENT_HDUHELP_AUTO_REFRESH_ENABLED=true
HDUHELP_REFRESH_CONCURRENCY=3
HDUHELP_REFRESH_REQUEST_SECONDS=20
HDUHELP_REFRESH_QUEUE_SECONDS=30
HDUHELP_REFRESH_TOTAL_SECONDS=60
# 思考内容与最终回答共用模型生成额度；DeepSeek 思考模式采用独立、有界额度。
# 标准/非思考请求仍默认 4096；两项的合法范围都是 256..16384。
# 已有部署若显式设置 AGENT_MAX_TOKENS 且未设置新参数，继续遵循原有成本限制。
# AGENT_MAX_TOKENS=4096
# DEEPSEEK_THINKING_MAX_TOKENS=16384
# HDUHelp 应用凭据需向 HDUHelp 申请；不要复用 CLI 的 client_id。
HDUHELP_BASE_URL=https://api.hduhelp.com
HDUHELP_APP_ID=
HDUHELP_APP_SECRET=
HDUHELP_REDIRECT_URI=http://127.0.0.1:8000/api/v1/hduhelp/callback
HDUHELP_SCOPES=contact:user.id:read,academic:student:read,academic:grade:read,academic:exam:read,campuslife:campuscard:read,librarybooking:seat:read
HDUHELP_TIMEOUT_SECONDS=20
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# 百度地图：部署默认值，可选。填写后重启后端，账号也可在个人设置分别配置两项 AK。
# 浏览器 AK 会经公开接口提供给地图页，配置 Referer 白名单；服务端 AK 仅后端使用，配置出口 IP 白名单。
# 详见 ../docs/project-documents/baidu-campus-map.md；不把实际 AK 或 .env 提交到 Git。
BAIDU_MAP_BROWSER_AK=
BAIDU_MAP_SERVER_AK=
# 可按现有 place_id 校准真实入口，值为 BD-09 数值 lat/lng 和可选 baidu_uid；默认不覆盖。
BAIDU_MAP_PLACE_OVERRIDES_JSON={}
BAIDU_MAP_REQUEST_TIMEOUT_SECONDS=5
BAIDU_MAP_TOTAL_TIMEOUT_SECONDS=15

# 第十四阶段：默认仅为杭电下沙账号提供杭州城市级预报，不读取设备位置。
# 其他校区需同时明确以下五项；坐标必须由部署者核对。无需天气 API Key。
# WEATHER_SCHOOL=学校全名
# WEATHER_CAMPUS=校区全名
# WEATHER_LOCATION_LABEL=已核验坐标对应的区域预报（非实时观测）
# WEATHER_LATITUDE=30.29365
# WEATHER_LONGITUDE=120.16142
