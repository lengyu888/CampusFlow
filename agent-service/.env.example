APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_PATH=data/campusflow.db
# 生产环境必填。生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_ENABLED=true
AGENT_TIMEOUT_SECONDS=90
# HDUHelp 应用凭据需向 HDUHelp 申请；不要复用 CLI 的 client_id。
HDUHELP_BASE_URL=https://api.hduhelp.com
HDUHELP_APP_ID=
HDUHELP_APP_SECRET=
HDUHELP_REDIRECT_URI=http://127.0.0.1:8000/api/v1/hduhelp/callback
HDUHELP_SCOPES=contact:user.id:read,academic:student:read,academic:grade:read,academic:exam:read,campuslife:campuscard:read,librarybooking:seat:read
HDUHELP_TIMEOUT_SECONDS=20
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# 第十四阶段：默认仅为杭电下沙账号提供杭州城市级预报，不读取设备位置。
# 其他校区需同时明确以下五项；坐标必须由部署者核对。无需天气 API Key。
# WEATHER_SCHOOL=学校全名
# WEATHER_CAMPUS=校区全名
# WEATHER_LOCATION_LABEL=已核验坐标对应的区域预报（非实时观测）
# WEATHER_LATITUDE=30.29365
# WEATHER_LONGITUDE=120.16142
